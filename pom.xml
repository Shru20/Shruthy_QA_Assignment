<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.abnamro</groupId>
    <artifactId>qa-backend-assignment</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>GitLab Issues API Test Suite</name>
    <description>
        Automated CRUD and edge-case tests for the GitLab Issues API, built on REST Assured,
        JUnit 5 and AssertJ. No GitLab-specific client library is used: the API itself is the
        system under test, so requests are constructed directly.
    </description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.10.2</junit.version>
        <rest-assured.version>5.4.0</rest-assured.version>
        <assertj.version>3.25.3</assertj.version>
        <allure.version>2.25.0</allure.version>
        <gson.version>2.10.1</gson.version>
        <faker.version>1.0.2</faker.version>
        <slf4j.version>2.0.12</slf4j.version>
        <logback.version>1.4.14</logback.version>

        <surefire.plugin.version>3.2.5</surefire.plugin.version>
        <compiler.plugin.version>3.12.1</compiler.plugin.version>
        <allure.plugin.version>2.12.0</allure.plugin.version>
    </properties>

    <dependencies>
        <!-- JUnit 5: aggregator brings api, params and engine together. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- HTTP client for the API under test. -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Fluent assertions. -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Request payload serialisation and response deserialisation. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Test data generation. -->
        <dependency>
            <groupId>com.github.javafaker</groupId>
            <artifactId>javafaker</artifactId>
            <version>${faker.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          Allure reporting. allure-rest-assured is deliberately NOT included: its
          filter attaches full request headers to the report, which would publish
          the PRIVATE-TOKEN to the GitHub Pages site. @Step annotations on the
          client already give per-call visibility without that exposure.
        -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Logging. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
                <configuration>
                    <!--
                      Execution is sequential by design. Every test shares one GitLab
                      project, and several assertions depend on its state being stable
                      for the duration of a test: the pagination tests assert exact page
                      contents, the default-sort test asserts relative ordering, and the
                      label filter tests assert an exact result count. Running methods in
                      parallel would let one test's writes appear in another's result set
                      and produce failures unrelated to the API.
                    -->
                    <includes>
                        <include>**/*Tests.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <allure.results.directory>
                            ${project.build.directory}/allure-results
                        </allure.results.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure.plugin.version}</version>
                <configuration>
                    <reportVersion>2.25.0</reportVersion>
                    <!-- Output path referenced by the GitHub Pages workflow. -->
                    <reportDirectory>${project.build.directory}/site/allure-maven-plugin</reportDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>